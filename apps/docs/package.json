{
  "name": "@eazip/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for Eazip, built with Next.js and Fumadocs",
  "scripts": {
    "dev": "next dev",
    "build:docs": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@eazip/core": "file:../../packages/core",
    "@eazip/react": "file:../../packages/react",
    "fumadocs-core": "^16.11.5",
    "fumadocs-mdx": "^12.0.3",
    "fumadocs-ui": "^15.8.5",
    "next": "^15.5.20",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.107.0"
  }
}
