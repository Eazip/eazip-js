{
  "name": "@eazip/react",
  "version": "0.1.0-beta.2",
  "description": "React hooks and a download tray for ZIP files and remote URLs in browser apps, with optional Eazip Cloud",
  "type": "module",
  "license": "MIT",
  "author": "Eazip <oss@eazip.io>",
  "homepage": "https://eazip.io/docs/react",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eazip/eazip-js",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Eazip/eazip-js/issues"
  },
  "keywords": [
    "eazip",
    "zip",
    "react",
    "hooks",
    "download",
    "browser",
    "javascript",
    "typescript",
    "client-side",
    "remote-url",
    "multiple-files"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eazip/core": "^0.2.0-beta.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
